# Copy this to .env and fill in your values
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/tojey?sslmode=require
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# Firebase Cloud Messaging (optional for Socket.IO-only delivery).
# Set EITHER the whole service-account JSON (base64) OR the three individual fields.
#   base64 -d <<< "$FIREBASE_SERVICE_ACCOUNT_B64"   should print the service-account JSON
FIREBASE_SERVICE_ACCOUNT_B64=
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
