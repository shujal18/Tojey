# Copy this to .env and fill in your values
DATABASE_URL=postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/tojey?sslmode=require
# Local/dev only: set PGSSLMODE=disable to allow a non-SSL Postgres (e.g. local).
PGSSLMODE=
JWT_SECRET=replace-with-a-long-random-secret
PORT=5000
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# Firebase Cloud Messaging (optional for Socket.IO-only delivery).
# Set EITHER the whole service-account JSON (base64) OR the three individual fields.
#   base64 -d <<< "$FIREBASE_SERVICE_ACCOUNT_B64"   should print the service-account JSON
FIREBASE_SERVICE_ACCOUNT_B64=
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# YouTube Data API v3 (for Reels feed)
# Get from Google Cloud Console -> APIs & Services -> Credentials
YOUTUBE_API_KEY=

# Shorts/Reels need no external service: metadata comes from the backend's own
# innertube client (backend/src/ytInner.js) and streams are resolved on-device by
# mobile/src/services/innertube.js. No Piped instance, proxy or API key is used.
